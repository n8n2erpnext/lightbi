{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightbi.local/schemas/language.schema.json",
  "title": "LightBI language package",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "messages"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "nativeLabel", "locale"],
      "properties": {
        "code": { "type": "string", "minLength": 2 },
        "label": { "type": "string", "minLength": 1 },
        "nativeLabel": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "direction": { "enum": ["ltr", "rtl"] }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" }
        }
      }
    }
  }
}
