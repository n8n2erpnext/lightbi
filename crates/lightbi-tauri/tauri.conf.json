{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightBI",
  "version": "0.1.0",
  "identifier": "digital.thaiduy.lightbi",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../apps/desktop build",
    "beforeDevCommand": "pnpm --dir ../apps/desktop dev",
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "LightBI",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
