{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightBI",
  "version": "0.9.1-beta.7",
  "identifier": "digital.thaiduy.lightbi",
  "build": {
    "beforeBuildCommand": "node ../scripts/prepare-native-sidecar.mjs --runtime-only && pnpm --dir ../apps/desktop build",
    "beforeDevCommand": "pnpm --dir ../apps/desktop dev",
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "LightBI",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/libstdc++-6.dll": "libstdc++-6.dll",
      "bin/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "bin/libwinpthread-1.dll": "libwinpthread-1.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
