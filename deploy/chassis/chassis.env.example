# Copy to ~/.config/lightbi-chassis-<name>.conf and chmod 600.
LIGHTBI_CHASSIS_NAME=next
LIGHTBI_RESTIC_ENV_FILE=/home/ubuntu/.config/lightbi-backup-r2.env
LIGHTBI_SNAPSHOT_STAGING_DIR=/home/ubuntu/.local/share/lightbi-dr/next/staging
LIGHTBI_POSTGRES_CONTAINER=lightbi-next-postgres
LIGHTBI_POSTGRES_USER=lightbi_next
LIGHTBI_POSTGRES_DB=lightbi_internal
LIGHTBI_SQLITE_DB=/home/ubuntu/services/lightbi-control-plane-next/data/distribution.sqlite
LIGHTBI_GENERATION_MANIFEST=/home/ubuntu/services/lightbi-next-runtime/lightbi-generation.json
LIGHTBI_ENGINE_CURRENT_LINK=/home/ubuntu/services/lightbi-next-engines/current
LIGHTBI_INFRA_COMPOSE=/home/ubuntu/services/lightbi-next-infra/compose.yml
LIGHTBI_INFRA_ENV=/home/ubuntu/.config/lightbi-next-infra.env
LIGHTBI_REDIS_POLICY=fresh_start
LIGHTBI_BACKUP_PATHS=(
  /home/ubuntu/services/lightbi-next-core-data
  /home/ubuntu/services/lightbi-next-runtime
  /home/ubuntu/services/lightbi-internal-generations
  /home/ubuntu/services/lightbi-next-infra
  /home/ubuntu/services/lightbi-next-releases
  /home/ubuntu/.config/lightbi-control-plane-next.env
  /home/ubuntu/.config/lightbi-next-core.env
  /home/ubuntu/.config/lightbi-next-infra.env
  /home/ubuntu/.config/systemd/user/lightbi-next-core.service
  /home/ubuntu/.config/systemd/user/lightbi-next-gateway.service
  /home/ubuntu/.config/systemd/user/lightbi-control-plane-next.service
  /home/ubuntu/.config/systemd/user/lightbi-control-plane-next-worker.service
  /home/ubuntu/.config/systemd/user/lightbi-next-release-sync.service
  /home/ubuntu/.config/systemd/user/lightbi-next-release-sync.timer
)
LIGHTBI_SERVICE_UNITS=(
  lightbi-next-core.service
  lightbi-control-plane-next.service
  lightbi-control-plane-next-worker.service
  lightbi-next-gateway.service
  lightbi-next-release-sync.timer
)
