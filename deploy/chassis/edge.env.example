LIGHTBI_EDGE_NAME=primary-edge
LIGHTBI_RESTIC_ENV_FILE=/home/ubuntu/.config/lightbi-backup-r2.env
LIGHTBI_EDGE_STAGING_DIR=/home/ubuntu/.local/share/lightbi-dr/edge/staging
LIGHTBI_EDGE_PAUSE_CONTAINER=netbird-server
LIGHTBI_EDGE_HELPER_IMAGE=postgres:16-alpine
LIGHTBI_EDGE_VOLUMES=(netbird_netbird_data netbird_netbird_traefik_letsencrypt)
LIGHTBI_EDGE_BACKUP_PATHS=(
  /home/ubuntu/netbird/config.yaml
  /home/ubuntu/netbird/docker-compose.yml
  /home/ubuntu/netbird/dashboard.env
  /home/ubuntu/netbird/proxy.env
  /home/ubuntu/netbird/traefik-dynamic.yaml
  /home/ubuntu/netbird/traefik-pages
  /home/ubuntu/netbird/crowdsec
  /home/ubuntu/netbird/zero-trust-syncd
)
