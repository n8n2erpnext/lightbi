    "countRules": [
      "COUNT(*) is descriptive row counting, not entity counting",
      "COUNT(column) excludes nulls",
      "COUNT(DISTINCT key) requires a governed key",
      "row and entity counts must preserve duplicate, snapshot and repeated-period risk",
      "automatic SUM-to-COUNT substitution is prohibited"
    ],
    "consentCorrectnessRules": [
      "userIntentKnown, exploratoryExecutionConsent and businessCorrectnessEstablished are independent",
      "acknowledgement never establishes business correctness",
      "acknowledgement never changes semantic or grain resolution",
      "acknowledgement never grants BA, narrative, alert or persisted-metric eligibility",
      "acknowledgement contains no raw sensitive values"
    ],
    "restrictionRules": [
      "restriction absence is not permission",
      "chart displayability is not decision safety",
      "ungoverned results remain identifiable downstream",
      "BA and narrative eligibility require approved governed metric evidence"
    ],
    "forbiddenEffects": [
      "mutate_runtime_plan",
      "change_generated_sql",
      "approve_operation",
      "execute_metric",
      "activate_domain",
      "wire_production",
      "persist_acknowledgement",
      "emit_telemetry",
      "infer_authority_from_operator",
      "replace_sum_with_count"
    ]
